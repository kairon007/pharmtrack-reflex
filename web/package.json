{
  "name": "pharmtrack-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "python3 tools/build-page.py && python3 tools/build-legal.py && vite build",
    "build:page": "python3 tools/build-page.py",
    "build:legal": "python3 tools/build-legal.py",
    "preview": "vite preview",
    "check": "node tools/check-page.mjs . --skip tools --skip _legacy_html --skip dist",
    "check:dist": "node tools/check-page.mjs dist"
  },
  "devDependencies": {
    "vite": "^8.0.1"
  }
}
